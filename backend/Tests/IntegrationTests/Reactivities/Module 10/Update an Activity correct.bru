meta {
  name: Update an Activity correct
  type: http
  seq: 4
}

put {
  url: {{url}}/api/activities
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
      "id": "15b63c9b-42e6-4d20-a115-34655b74b6e0",
      "title": "Future Activity 33",
      "date": "2026-08-20T00:00:00",
      "description": "Activity 3 months in future",
      "category": "drinks",
      "isCancelled": false,
      "city": "London",
      "venue": "The Mayflower",
      "latitude": 0,
      "longitude": 0
    }
}

script:pre-request {
  var moment = require("moment");
  
  bru.setEnvVar('activityDate', moment().add(14, 'days').toISOString());
}

settings {
  encodeUrl: true
  timeout: 0
}
